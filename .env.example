# Copy to .env next to docker-compose.yml; docker compose reads it automatically.

# Host user that owns docker/config.yaml and docker/ssh (see `id -u` / `id -g`).
PROXY_UID=1000
PROXY_GID=1000

# Host address and port for the published proxy port. Keep 127.0.0.1 unless
# proxy credentials or stealth mode are configured and remote access is wanted.
PROXY_BIND=127.0.0.1
PROXY_PORT=8888

# Image tag: latest, X.Y, or X.Y.Z.
HTTP_SSH_PROXY_TAG=latest
